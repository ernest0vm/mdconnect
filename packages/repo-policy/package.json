{
  "name": "@mdconnect/repo-policy",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-2.0-only",
  "type": "module",
  "description": "Executable repo rules: supply-chain settings, banned dependencies and workspace conventions.",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@mdconnect/tsconfig": "workspace:^",
    "@types/node": "^22.20.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
