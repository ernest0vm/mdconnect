# mdconnect: let the logged-in user open supported MiniDisc devices (NetMD and Hi-MD).
# Install: sudo cp 60-mdconnect.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# Generated from packages/core/src/devices.ts; a unit test fails if the two drift apart.

